{
	"name": "qmd-search",
	"version": "1.1.3",
	"description": "Semantic-first search for Obsidian using QMD",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"semantic-search",
		"qmd",
		"markdown"
	],
	"author": "Oleksii Chekulaiev <achekulaev@gmail.com>",
	"license": "MIT",
	"devDependencies": {
		"@types/jest": "^29.5.12",
		"@types/node": "^20.11.0",
		"@typescript-eslint/eslint-plugin": "^6.19.0",
		"@typescript-eslint/parser": "^6.19.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.19.11",
		"eslint": "^8.56.0",
		"jest": "^29.7.0",
		"obsidian": "latest",
		"ts-jest": "^29.4.11",
		"tslib": "^2.8.1",
		"typescript": "^5.3.3"
	}
}
